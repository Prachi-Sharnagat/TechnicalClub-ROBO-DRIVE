rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // The one and only admin account (technical@club on the login screen).
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'technical@club.example';
    }
    function validResult() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'time', 'updatedAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 40
        && d.time is number && d.time > 0 && d.time < 100000;
    }
    match /results/{id} {
      allow read: if true;                              // public leaderboard
      allow create, update: if isAdmin() && validResult();
      allow delete: if isAdmin();
    }
    match /{document=**} { allow read, write: if false; }
  }
}
